<Window x:Class="CloudLight.CodexBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudLight Codex Bridge" Icon="Resources/AppIcon.ico"
        Width="1280" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="20,22,16,18"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Image Source="Resources/AppIcon.png" Stretch="Uniform" Margin="2"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="CloudLight" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Codex Bridge" Style="{StaticResource SecondaryTextStyle}" FontSize="11"/></StackPanel>
                </Grid>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="工作区" Style="{StaticResource EyebrowTextStyle}" Margin="20,10,0,8"/>
                    <RadioButton Content="概览" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsOverviewPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="overview"/>
                    <RadioButton Content="任务中心" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsTasksPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="tasks"/>
                    <RadioButton Content="项目工作区" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsProjectsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="projects"/>
                    <RadioButton Content="Codex" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsSessionsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="sessions"/>
                    <RadioButton Content="OpenClaw" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsOpenClawPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="openclaw"/>
                    <RadioButton Content="QQ" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsQqPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="qq"/>
                    <RadioButton Content="Telegram" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsTelegramPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="telegram"/>
                    <RadioButton Content="Codex 指令" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsCommandsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="commands"/>
                    <RadioButton Content="OpenClaw 指令" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsOpenClawCommandsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="openclaw-commands"/>
                    <RadioButton Content="消息同步" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsMirrorPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="mirror"/>
                    <RadioButton Content="备份与恢复" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsBackupPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="backup"/>
                    <Separator Margin="18,12"/>
                    <RadioButton Content="运行日志" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsLogsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="logs"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <RadioButton Content="设置" Style="{StaticResource NavigationButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsSettingsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="settings"/>
                    <TextBlock Text="v1.3.0" Style="{StaticResource SecondaryTextStyle}" Margin="20,8,0,5"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding PageDescription}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource BadgeStyle}" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding AppServerState}" FontSize="12" VerticalAlignment="Center"/></StackPanel></Border>
                        <Button Content="刷新" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="{StaticResource PagePadding}"/>
            <Border Grid.RowSpan="2" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" MaxWidth="620" Visibility="{Binding ErrorVisibility}">
                <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Foreground="{DynamicResource WarningBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
