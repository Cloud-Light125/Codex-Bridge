<UserControl x:Class="CloudLight.CodexBridge.Views.ChannelProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding PageTitle}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding PageDescription}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="{Binding AddButtonText}" Command="{Binding AddCurrentProfileCommand}"/><Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding BusyVisibility}" Margin="0,0,0,16"><StackPanel><TextBlock Text="正在更新消息渠道状态…" FontWeight="SemiBold"/><ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding EmptyVisibility}" Margin="0,0,0,16"><TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource MutedBrush}"/></Border>
            <ItemsControl ItemsSource="{Binding ProfilesView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PlatformLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="19" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Margin="10,-4,0,0" MinWidth="180"/></StackPanel><TextBlock Text="{Binding Id}" FontFamily="Consolas" Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="启动" Command="{Binding DataContext.StartProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="停止" Command="{Binding DataContext.StopProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0"/><Button Content="删除" Tag="{Binding}" Click="DeleteProfile_Click" Foreground="{DynamicResource ErrorBrush}" Margin="8,0,0,0"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox Content="启用这个 Profile" IsChecked="{Binding Enabled}" Margin="0,0,0,8"/>
                                        <CheckBox Content="启动 Bridge 时自动连接" IsChecked="{Binding AutoStart}" Margin="0,0,0,8"/>
                                        <CheckBox Content="将运行进度发送到聊天" IsChecked="{Binding SendProgressUpdates}" Margin="0,0,0,12"/>
                                        <StackPanel Visibility="{Binding TelegramVisibility}"><TextBlock Text="Telegram Token（只保存到 DPAPI，不写入 settings.json）" Style="{StaticResource FieldLabelStyle}"/><PasswordBox PasswordChanged="SecretBox_PasswordChanged" Padding="10,7" Margin="0,5,0,0"/><TextBlock Text="允许的用户 ID（每行一个）" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/><TextBox Text="{Binding AllowedIdsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70"/><TextBlock Text="Polling 超时（秒）" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/><TextBox Text="{Binding PollingTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        <StackPanel Visibility="{Binding QqVisibility}"><TextBlock Text="AppID" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/><TextBlock Text="AppSecret（只保存到 DPAPI，不写入 settings.json）" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/><PasswordBox PasswordChanged="SecretBox_PasswordChanged" Padding="10,7"/><TextBlock Text="允许的用户 OpenID（每行一个）" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/><TextBox Text="{Binding AllowedIdsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70"/><CheckBox Content="Gateway 断线后自动重连" IsChecked="{Binding ReconnectEnabled}" Margin="0,12,0,0"/></StackPanel>
                                        <TextBlock Text="代理模式" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/><ComboBox SelectedValue="{Binding ProxyMode}" SelectedValuePath="Tag"><ComboBoxItem Content="使用环境变量" Tag="environment"/><ComboBoxItem Content="直接连接" Tag="direct"/><ComboBoxItem Content="自定义 HTTP 代理" Tag="custom-http"/></ComboBox><TextBox Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="自定义 HTTP 代理，例如 http://127.0.0.1:7897" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource CodeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel><TextBlock Text="连接与分配" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/><TextBlock Text="{Binding SharedText}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="账户" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,3"/><TextBlock Text="{Binding AccountText}" TextWrapping="Wrap"/><TextBlock Text="凭据" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,3"/><TextBlock Text="{Binding CredentialSummary}" TextWrapping="Wrap"/><TextBlock Text="绑定" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,3"/><TextBlock Text="{Binding BindingCountText}"/><CheckBox Content="分配给 Codex" IsChecked="{Binding CodexAssigned}" Margin="0,16,0,6"/><CheckBox Content="分配给 OpenClaw" IsChecked="{Binding OpenClawAssigned}"/><TextBlock Text="同一 Token / AppID+Secret 被多个 Profile 使用时，Bridge 只会维护一个 Poller / Gateway。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="{Binding LastError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="保存 Profile" Command="{Binding DataContext.SaveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}"/><TextBlock Text="更改后也请保存后端分配。" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Backend Routing" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="勾选项决定每个后端可以使用哪些 Channel Profile；实际聊天投递仍由包含 backend、profile、conversation 与 targetId 的显式绑定决定。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/><Button Content="保存 Codex / OpenClaw 分配" Command="{Binding SaveRoutingCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
