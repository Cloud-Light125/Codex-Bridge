<UserControl x:Class="CloudLight.CodexBridge.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="项目工作区" FontSize="20" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}"/>
                </Grid>
                <Button Grid.Row="1" Content="+ 新建项目" Command="{Binding NewCommand}" Margin="14,0,14,10" HorizontalAlignment="Left"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AliasText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding BackendDisplay}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Project 设置" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="项目只保存工作区与路由偏好；凭据仍由现有 Channel/Profile 管理。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="删除" Command="{Binding DeleteCommand}" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,8,0"/>
                            <Button Content="保存" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="名称" Style="{StaticResource EyebrowTextStyle}" Margin="0,22,0,4"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="别名（逗号分隔）" Style="{StaticResource EyebrowTextStyle}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="工作目录" Style="{StaticResource EyebrowTextStyle}" Margin="0,14,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="选择文件夹" Command="{Binding ChooseDirectoryCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <Border Background="{DynamicResource CodeBrush}" Padding="10" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Git 状态" Style="{StaticResource SectionTitleStyle}"/>
                                <Button Grid.Column="1" Content="刷新 Git" Command="{Binding RefreshGitStatusCommand}"/>
                            </Grid>
                            <TextBlock Text="查询固定只读 Git 状态，不会修改工作区。" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Git Repository" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="1" Text="{Binding GitStatus.RepositoryDisplay}"/>
                                <TextBlock Grid.Column="2" Text="Branch" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="3" Text="{Binding GitStatus.Branch}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Working Tree" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="1" Text="{Binding GitStatus.WorkingTreeDisplay}"/>
                                <TextBlock Grid.Column="2" Text="最新提交" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="3" Text="{Binding GitStatus.LatestCommit}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock Text="{Binding GitStatus.Error}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding GitStatusErrorVisibility}"/>
                            <TextBlock Text="读取中…" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" Visibility="{Binding GitStatusBusyVisibility}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="描述" Style="{StaticResource EyebrowTextStyle}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="默认 Backend" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding DefaultBackend}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Codex" Tag="codex"/>
                                <ComboBoxItem Content="OpenClaw" Tag="openclaw"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="默认 Conversation" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ConversationView}" DisplayMemberPath="Label" SelectedValuePath="Number" SelectedValue="{Binding DefaultConversationNumber}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock Text="复用策略" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding ReuseStrategy}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="默认" Tag="default"/>
                                <ComboBoxItem Content="最近会话" Tag="latest"/>
                                <ComboBoxItem Content="固定会话" Tag="fixed"/>
                                <ComboBoxItem Content="新建会话" Tag="create-new"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="没有合适会话时自动创建 Conversation（需 Backend 支持）" IsChecked="{Binding AutoCreateConversation}" Margin="0,16,0,0"/>
                    <CheckBox Content="启用此 Project" IsChecked="{Binding Enabled}" Margin="0,8,0,0"/>
                    <TextBlock Text="标签（逗号分隔）" Style="{StaticResource EyebrowTextStyle}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Padding="10" Margin="0,18,0,0" Visibility="{Binding ErrorVisibility}">
                        <TextBox Text="{Binding ErrorText, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
