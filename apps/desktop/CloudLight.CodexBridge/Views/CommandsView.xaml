<UserControl x:Class="CloudLight.CodexBridge.Views.CommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding PageTitle}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding PageDescription}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,20,0"/><TextBlock Text="{Binding BackendNotice}" Visibility="{Binding BackendNoticeVisibility}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,9,20,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="+ 添加指令" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding EditorVisibility}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="指令名称" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="显示名称" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="别名（每行或逗号分隔）" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/><TextBox Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="功能" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Actions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SelectedAction}" IsEnabled="{Binding IsActionEditable}"/><TextBlock Text="说明" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/><TextBlock Text="参数" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/><TextBox Text="{Binding ParameterHelp, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="启用" IsChecked="{Binding Enabled}" Margin="0,14,0,0"/></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="取消" Command="{Binding CancelEditCommand}" Margin="8,0,0,0"/></StackPanel>
                </StackPanel>
            </Border>

            <TextBox Text="{Binding OperationMessage, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Commands}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="19" FontWeight="SemiBold"/><Border Style="{StaticResource BadgeStyle}" Margin="10,0,0,0"><TextBlock Text="{Binding TypeDisplay}" FontSize="11"/></Border><Border Style="{StaticResource BadgeStyle}" Margin="6,0,0,0"><TextBlock Text="{Binding StatusDisplay}" FontSize="11"/></Border></StackPanel>
                                    <TextBlock Text="{Binding ChineseName}" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding UsageExample, StringFormat=示例：{0}}" FontFamily="Consolas" Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding ChannelSupportDisplay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding CompatibilityDisplay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding CapabilityDisplay}" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding AliasesDisplay, StringFormat=别名：{0}}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding LockDisplay}" Visibility="{Binding LockVisibility}" Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding Model.TelegramMenuNotice}" Visibility="{Binding TelegramNoticeVisibility}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" MaxWidth="330" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button Content="解锁" Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding UnlockVisibility}" Margin="4"/>
                                    <Button Content="编辑" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding EditVisibility}" Margin="4"/>
                                    <Button Content="重新锁定" Command="{Binding DataContext.LockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding LockButtonVisibility}" Margin="4"/>
                                    <Button Content="删除" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding DeleteVisibility}" Margin="4"/>
                                    <Button Content="恢复初始指令" ToolTip="系统指令恢复程序默认值并重新锁定；自定义指令恢复首次创建成功时的配置。" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="4"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
