<UserControl x:Class="CloudLight.CodexBridge.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="任务中心" FontSize="20" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}"/>
                </Grid>
                <Grid Grid.Row="1" Margin="14,0,14,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索 T 编号、标题或项目"/>
                    <ComboBox Grid.Column="1" Width="112" Margin="8,0,0,0" SelectedValue="{Binding StatusFilter}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="全部" Tag=""/>
                        <ComboBoxItem Content="运行中" Tag="running"/>
                        <ComboBoxItem Content="等待输入" Tag="waiting-input"/>
                        <ComboBoxItem Content="已完成" Tag="completed"/>
                        <ComboBoxItem Content="失败" Tag="failed"/>
                    </ComboBox>
                </Grid>
                <TextBlock Grid.Row="2" Margin="16,0,16,9" Foreground="{DynamicResource MutedBrush}"
                           Text="{Binding TaskCountsText}"/>
                <ListBox Grid.Row="3" ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding NumberLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ProjectNameSnapshot}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ConversationDisplay}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DurationDisplay}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="快速创建任务" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Project 自动决定 Backend 与 Conversation" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="20,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name"/>
                            <ComboBox Grid.Column="1" Margin="8,0,0,0" SelectedValue="{Binding NewBackend}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Codex" Tag="codex"/>
                                <ComboBoxItem Content="OpenClaw" Tag="openclaw"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding ConversationView}" DisplayMemberPath="Label" SelectedValuePath="Number" SelectedValue="{Binding NewConversationNumber}" ToolTip="留空时按 Project 策略自动分配"/>
                        </Grid>
                        <TextBox Margin="0,8,0,0" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="标题（可选）"/>
                        <TextBox Margin="0,8,0,0" MinHeight="48" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="详细任务内容"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="+ 开始任务" Command="{Binding CreateCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedTask}" Margin="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NumberLabel}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,6,0,16"/>
                            <TextBlock Text="{Binding ActionSourceDisplay}" Foreground="{DynamicResource MutedBrush}" Margin="0,-8,0,12" Visibility="{Binding ActionSourceVisibility}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="项目" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="1" Text="{Binding ProjectNameSnapshot}"/>
                                <TextBlock Grid.Column="2" Text="Backend" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="3" Text="{Binding BackendDisplay}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="会话" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="1" Text="{Binding ConversationDisplay}"/>
                                <TextBlock Grid.Column="2" Text="Target" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="3" Text="{Binding TargetId}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="创建" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}"/>
                                <TextBlock Grid.Column="2" Text="开始" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="3" Text="{Binding StartedAtDisplay}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="完成" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="1" Text="{Binding CompletedAtDisplay}"/>
                                <TextBlock Grid.Column="2" Text="耗时" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="3" Text="{Binding DurationDisplay}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="最近活动" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Grid.Column="1" Text="{Binding LastActivityAtDisplay}"/>
                            </Grid>
                            <Separator Margin="0,16"/>
                            <TextBlock Text="原始任务内容" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBox Text="{Binding Description}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="最终结果" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,0"/>
                            <TextBox Text="{Binding Result.FinalText}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="70"/>
                            <TextBlock Text="结构化摘要" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,0"/>
                            <TextBox Text="{Binding SummaryText, FallbackValue=—}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <StackPanel Visibility="{Binding DataContext.TaskAnswerVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,18,0,0">
                                <TextBlock Text="等待输入" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding PendingQuestion}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DataContext.TaskAnswerText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="提交回答" Command="{Binding DataContext.AnswerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock Text="快捷操作" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,0"/>
                            <TextBlock Text="按钮由 Backend Capability、Task 状态和 Project 工作区动态决定。" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="继续说明：" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Width="330" Text="{Binding DataContext.ContinueText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" ToolTip="继续任务内容" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DataContext.AvailableActions, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}" ToolTip="{Binding Description}" Command="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Padding="10" Margin="0,4,0,0" Visibility="{Binding DataContext.ActionConfirmationVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel>
                                    <TextBlock Text="提交并推送是高风险操作" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="将创建新的 Task，并要求 Codex 仅提交相关正式修改后普通 push；不会由 Bridge 本地直接执行 Git 写操作。" TextWrapping="Wrap" Margin="0,5,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="确认执行" Command="{Binding DataContext.ConfirmActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Content="取消" Command="{Binding DataContext.CancelActionConfirmationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CodeBrush}" Padding="10" Margin="0,8,0,0" Visibility="{Binding DataContext.ActionResultVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel>
                                    <TextBlock Text="操作结果" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding DataContext.ActionResultHeader, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                    <TextBox Text="{Binding DataContext.ActionResultText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="70"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
